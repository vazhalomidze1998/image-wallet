# Used by docker-compose.yml. Copy to .env and fill in.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_wallet

# Local S3-compatible storage (SeaweedFS). Must match AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in backend/.env.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
S3_ACCESS_KEY=
S3_SECRET_KEY=
