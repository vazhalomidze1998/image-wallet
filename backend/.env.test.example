# Test environment (S3 is mocked in tests; secrets here are NOT real).
# ---------- App ----------
NODE_ENV=test
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_wallet_test?schema=public

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=test-jwt-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# ---------- S3 storage ----------
# Local dev (free): SeaweedFS from docker-compose.yml. Keys must match S3_ACCESS_KEY /
# S3_SECRET_KEY in the root .env. For real AWS S3: set your region/keys/bucket and
# leave AWS_S3_ENDPOINT + AWS_S3_PUBLIC_ENDPOINT empty and AWS_S3_FORCE_PATH_STYLE=false.
AWS_REGION=us-east-1
# Real AWS: leave empty to use the default credential chain (e.g. IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=test-bucket
AWS_S3_ENDPOINT=http://localhost:8333
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true
# Presigned URL lifetime in seconds
S3_PRESIGNED_TTL=900

# ---------- Images ----------
MAX_UPLOAD_SIZE_MB=10

# ---------- Payments ----------
# Shared secret used to verify webhook HMAC signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=test-webhook-secret-123

# ---------- SMS (top-up confirmation codes) ----------
# Twilio: https://console.twilio.com — leave empty to log codes to the console instead
# (outside production the code is then also shown on the Top up page).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +15005550006
TWILIO_FROM_NUMBER=
# How long a confirmation code stays valid
OTP_TTL_SECONDS=300
